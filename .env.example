# PostgreSQL (Neon): https://console.neon.tech -> Connection string
# Pooled connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# Direct connection (same host without "-pooler"), used by Prisma migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# 32-byte base64 key used to encrypt users' API keys.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it after users have saved keys, or existing keys can't be decrypted.
ENCRYPTION_KEY=""

# The only account that can open /admin
ADMIN_EMAIL="rehanhuzaifa035@gmail.com"

# Resend (password-reset emails). If empty, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="KamKarOAI <onboarding@resend.dev>"
